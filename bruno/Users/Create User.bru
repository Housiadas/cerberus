meta {
  name: Create User
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/v1/users
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "name": "John Doe",
    "email": "john.doe@example.com",
    "department": "engineering",
    "password": "password123",
    "passwordConfirm": "password123"
  }
}
